#!/usr/bin/env bash
# Single entry point for all test suites.
#   bin/test            rspec (engine, backend) + frontend typecheck and unit tests
#   bin/test web        frontend only (typecheck + node tests)
#   bin/test fast       the fast stage of the PR check, locally (no game_flow, no browser, no lock; target < 2 min)
#   bin/test changed    only the tests of files changed against origin/main (see below)
#   bin/test <args>     rspec with the given arguments (files, -e, --tag ...)  (no lock unless it names whole-game or browser specs)
# 'fast' and 'changed' take '--list' as 2nd argument: print what would run, run nothing.
# Only heavy runs take the machine-wide heavy lock (tmp/heavy.lock of the main checkout): no arguments,
# 'web', and arguments naming whole-game/browser specs (bot_simulation|playthrough|script_game|
# enumeration_timing|browser). Targeted runs (single specs, 'changed') take no lock and run side by side.
# The lock is never waited for by default (OE_LOCK_TIMEOUT seconds, default 0): if it is held, the holder
# (tmp/heavy.lock.holder) is printed and the run exits 75. Look: lslocks | grep heavy
# OE_HEAVY_LOCK_HELD=1 skips the lock (caller already holds it).
set -euo pipefail
source "$(dirname "$0")/_env"
cd "$ROOT"

heavy=0
case "${1:-}" in
  ""|web) heavy=1 ;;
  changed|fast) heavy=0 ;;
  *) if printf '%s\n' "$*" | grep -q -E 'bot_simulation|playthrough|script_game|enumeration_timing|browser'; then heavy=1; fi ;;
esac

if [ "$heavy" = 1 ] && [ -z "${OE_HEAVY_LOCK_HELD:-}" ] && command -v flock >/dev/null 2>&1; then
  common="$(git rev-parse --git-common-dir 2>/dev/null || true)"
  lock="$(cd "$ROOT" && cd "$(dirname "$common")" 2>/dev/null && pwd)/tmp/heavy.lock"
  holder="$lock.holder"
  mkdir -p "$(dirname "$lock")"
  limit="${OE_LOCK_TIMEOUT:-0}"
  exec 9>>"$lock"
  if ! flock -w "$limit" 9; then
    echo "bin/test: heavy lock $lock is held; not waiting (limit ${limit}s)." >&2
    echo "bin/test: holder: $(cat "$holder" 2>/dev/null || echo unknown). See: lslocks | grep heavy" >&2
    echo "bin/test: do something else and retry later, or run targeted specs (no lock) / push and read the CI checks." >&2
    exit 75
  fi
  echo "pid=$$ user=${USER:-?} cwd=$PWD args=$* since=$(date -u +%FT%TZ)" > "$holder"
  trap 'rm -f "$holder"' EXIT
  export OE_HEAVY_LOCK_HELD=1
fi

web() { (cd "$ROOT/web" && npm run --silent typecheck && npm test --silent); }

camel() { printf '%s' "$1" | awk -F_ '{for(i=1;i<=NF;i++) printf "%s%s", toupper(substr($i,1,1)), substr($i,2)}'; }

# Prints a command and, unless --list, runs it.
run() { echo "+ $*"; [ "$LIST" = 1 ] || "$@"; }

# Fast stage (#365), the local twin of the PR stage in ci.yml: every rspec example that does not play a
# seed game or a recorded log (--tag ~game_flow; :full_game stays out via engine_helper), engine specs
# included, plus typecheck and the browser-free web unit tests (they hold the contract tests text.test.ts
# and the view-keys check in spec/web_spec.rb). No browser, no lock. rspec and the web part run side by
# side (OE_FAST_SHARDS rspec processes, default 3); target: under 2 min. spec/web_spec.rb skips its dist-based examples if web/dist is not built.
fast() {
  local files tlog n="${OE_FAST_SHARDS:-3}" i rc=0 pids=() logs=() sf
  files="$(cd "$ROOT/web" && ls test/*.test.ts | grep -v -E '(-browser|^test/shot|^test/ipad)' | tr '\n' ' ')"
  if [ "$LIST" = 1 ]; then
    for i in $(seq 1 "$n"); do echo "+ bundler exec rspec \$(ruby .github/scripts/shard.rb $i $n '') --tag ~game_flow --format progress"; done
    echo "+ (cd web && npm run --silent typecheck && node --test ${files})"
    return 0
  fi
  tlog="$(mktemp)"
  ( cd "$ROOT/web" && npm run --silent typecheck && node --test $files ) >"$tlog" 2>&1 &
  local wpid=$!
  # n time-balanced rspec processes side by side (about 0.9 GB each), same shard script as the CI.
  for i in $(seq 1 "$n"); do
    sf="$(mktemp)"; logs+=("$sf")
    ( bundler exec rspec $(ruby .github/scripts/shard.rb "$i" "$n" '' 2>/dev/null) --tag '~game_flow' --format progress ) >"$sf" 2>&1 &
    pids+=($!)
  done
  for i in "${!pids[@]}"; do
    if wait "${pids[$i]}"; then echo "rspec shard $((i+1))/$n: $(grep -E '^[0-9]+ examples' "${logs[$i]}")"
    else rc=1; echo "rspec shard $((i+1))/$n FAILED"; cat "${logs[$i]}"; fi
  done
  if wait "$wpid"; then echo "web: typecheck + unit tests ok"; else echo "web: FAILED"; tail -60 "$tlog"; rc=1; fi
  rm -f "$tlog" "${logs[@]}"
  return "$rc"
}

# Changed files against origin/main (plus uncommitted) -> matching spec and unit-test files.
# Browser tests (*-browser, shot, ipad) are left to the CI job "browser".
# Mapping (#365):
#   lib/engine/game/g_18_oe/{step,round}/x.rb  -> spec/engine specs named *x* or mentioning Step::X / Round::X
#   other lib/engine/game/g_18_oe/*            -> all of spec/engine/g_18_oe (no seed game, about 100 s)
#   lib/engine/game/g_18_oe_uk_fr/*            -> spec/engine/g_18_oe_uk_fr
#   other lib/engine/**                        -> spec/engine/smoke_spec.rb (run bin/test fast for more)
#   contract: lib/oe/view.rb, web/types.ts, web/view-keys.json, web/test/fixtures/games/*
#                                              -> the view-keys part of spec/web_spec.rb + text.test.ts
#                                                 (fixtures: all browser-free web unit tests, 6 s)
#   lib/oe/*.rb, spec/*_spec.rb, web/**/x.ts   -> by file name, as before
# OE_CHANGED_FILES="a b" replaces the git file list (to try the mapping); --list only prints.
changed() {
  local files specs=() tests=() examples=() f base cc s alltests=0
  if [ -n "${OE_CHANGED_FILES:-}" ]; then files="$(printf '%s\n' $OE_CHANGED_FILES | sort -u)"
  else files="$( { git diff --name-only origin/main...HEAD; git diff --name-only HEAD; git ls-files --others --exclude-standard; } | sort -u)"; fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    base="$(basename "$f")"; base="${base%.*}"
    case "$f" in
      spec/*_spec.rb) [ -f "$f" ] && specs+=("$f") ;;
      lib/engine/game/g_18_oe/step/*.rb|lib/engine/game/g_18_oe/round/*.rb)
        cc="$(camel "$base")"
        while IFS= read -r s; do specs+=("$s"); done < <( { find spec/engine -name "*${base}*_spec.rb"; grep -rlE "(Step|Round)::${cc}\b" spec/engine --include='*_spec.rb' || true; } | sort -u) ;;
      lib/engine/game/g_18_oe/*) while IFS= read -r s; do specs+=("$s"); done < <(find spec/engine/g_18_oe -name '*_spec.rb') ;;
      lib/engine/game/g_18_oe_uk_fr/*) while IFS= read -r s; do specs+=("$s"); done < <(find spec/engine/g_18_oe_uk_fr -name '*_spec.rb') ;;
      lib/engine/*|lib/engine.rb) specs+=(spec/engine/smoke_spec.rb) ;;
      lib/oe/view.rb|web/types.ts|web/view-keys.json)
        examples+=("view model contract"); tests+=("test/text.test.ts") ;;
      web/test/fixtures/games/*) alltests=1 ;;
      lib/*.rb|lib/**/*.rb|bin/*.rb)
        while IFS= read -r s; do specs+=("$s"); done < <(find spec -name "${base}_spec.rb" -o -name "*${base}*_spec.rb" | grep -v -E 'script_game|playthrough|bot_simulation|enumeration_timing' || true) ;;
      web/test/*.test.ts) case "$f" in *-browser*|*shot*|*ipad*) ;; *) [ -f "$f" ] && tests+=("test/$(basename "$f")") ;; esac ;;
      web/*.ts) [ -f "web/test/${base}.test.ts" ] && tests+=("test/${base}.test.ts") ;;
    esac
  done <<< "$files"
  if [ "$alltests" = 1 ]; then
    tests=(); while IFS= read -r s; do tests+=("$s"); done < <(cd "$ROOT/web" && ls test/*.test.ts | grep -v -E '(-browser|^test/shot|^test/ipad)')
  fi
  if [ "${#specs[@]}" -eq 0 ] && [ "${#tests[@]}" -eq 0 ] && [ "${#examples[@]}" -eq 0 ]; then
    echo "bin/test changed: no matching tests for the changed files (nothing run). Push and read the CI checks." >&2
    return 0
  fi
  local rc=0
  if [ "${#specs[@]}" -gt 0 ]; then
    mapfile -t specs < <(printf '%s\n' "${specs[@]}" | sort -u)
    run bundler exec rspec "${specs[@]}" || rc=$?
  fi
  # The contract part of web_spec.rb alone, unless web_spec.rb runs whole above.
  if [ "${#examples[@]}" -gt 0 ] && ! printf '%s\n' "${specs[@]:-}" | grep -qx 'spec/web_spec.rb'; then
    run bundler exec rspec spec/web_spec.rb -e "${examples[0]}" || rc=$?
  fi
  if [ "${#tests[@]}" -gt 0 ]; then
    mapfile -t tests < <(printf '%s\n' "${tests[@]}" | sort -u)
    echo "+ (cd web && typecheck && node --test ${tests[*]})"
    if [ "$LIST" != 1 ]; then (cd "$ROOT/web" && npm run --silent typecheck && node --test "${tests[@]}") || rc=$?; fi
  fi
  return "$rc"
}

LIST=0
case "${2:-}" in --list) LIST=1 ;; esac
case "${1:-}" in
  web) web ;;
  fast) fast ;;
  changed) changed ;;
  "") bundler exec rspec; web ;;
  *) bundler exec rspec "$@" ;;
esac
