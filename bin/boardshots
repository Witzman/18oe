#!/usr/bin/env bash
# Screenshots of the real built UI (web/dist) for the feedback board (workshop #374).
#   bin/boardshots [scene-name ...]     all scenes of bin/boardshots.json, or the named ones
# Needs a built web app (`cd web && npm run build`). Writes tmp/board/<scene>.png (OE_BOARD_OUT overrides the
# folder) at 1747x923 and the catalog the stub API serves to tmp/board/catalog.json. Every scene is a separate
# browser run under bin/shot.mjs (heavy.lock, hard timeout): one browser at a time on the machine (rules 22 to 25).
set -euo pipefail
source "$(dirname "$0")/_env"
cd "$ROOT"
out="${OE_BOARD_OUT:-$ROOT/tmp/board}"
mkdir -p "$out"
[ -d web/dist ] || { echo "boardshots: web/dist missing, run: cd web && npm run build" >&2; exit 1; }
bundler exec ruby -Ilib -e 'require "oe/catalog"; puts Oe::Catalog.json' > "$out/catalog.json"
exec node bin/boardshots.mjs "$ROOT/web" "$out" "$out/catalog.json" "$@"
