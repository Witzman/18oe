#!/usr/bin/env bash
# Idempotent: installs gems into vendor/bundle and Node into .tools/node.
set -euo pipefail
source "$(dirname "$0")/_env"
cd "$ROOT"

bundler install

NODE_VERSION="${NODE_VERSION:-22.23.5}"
if [ ! -x "$ROOT/.tools/node/bin/node" ]; then
  case "$(uname -m)" in x86_64) arch=x64;; aarch64|arm64) arch=arm64;; *) echo "unsupported arch" >&2; exit 1;; esac
  name="node-v${NODE_VERSION}-linux-${arch}"
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  base="https://nodejs.org/dist/v${NODE_VERSION}"
  curl -fsSL -o "$tmp/$name.tar.xz" "$base/$name.tar.xz"
  curl -fsSL -o "$tmp/SHASUMS256.txt" "$base/SHASUMS256.txt"
  (cd "$tmp" && grep " $name.tar.xz\$" SHASUMS256.txt | sha256sum -c -)
  mkdir -p "$ROOT/.tools/node"
  tar -xJf "$tmp/$name.tar.xz" -C "$ROOT/.tools/node" --strip-components=1
fi
echo "node $(node --version)"
(cd "$ROOT/web" && npm ci --no-progress)
